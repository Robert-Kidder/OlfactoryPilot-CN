    {"id":"c-note-text","type":"text","x":1225,"y":1010,"width":510,"height":70,"angle":0,"strokeColor":"#7048e8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":157,"version":1,"versionNonce":1057,"isDeleted":false,"boundElements":null,"updated":1785542400000,"link":null,"locked":false,"index":"bK","text":"C · 真空流量\n上一个样品结束后开启，直到下一个气味释放，\n用于刺激间隔期抽走残留气味；连接点待实物确认。","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","baseline":64,"containerId":null,"originalText":"C · 真空流量\n上一个样品结束后开启，直到下一个气味释放，\n用于刺激间隔期抽走残留气味；连接点待实物确认。","lineHeight":1.3},
    {"id":"mapping-warning","type":"text","x":50,"y":1140,"width":1510,"height":50,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":158,"version":1,"versionNonce":1058,"isDeleted":false,"boundElements":null,"updated":1785542400000,"link":null,"locked":false,"index":"bL","text":"现场核对项：当前配置中的 Dev2/P1.0（master_valve）可能与图示电磁阀 21 存在命名/接线映射冲突；在核对机柜接线、阀标签或逐路验证前，不作为已确认硬件事实。","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":43,"containerId":null,"originalText":"现场核对项：当前配置中的 Dev2/P1.0（master_valve）可能与图示电磁阀 21 存在命名/接线映射冲突；在核对机柜接线、阀标签或逐路验证前，不作为已确认硬件事实。","lineHeight":1.35}
