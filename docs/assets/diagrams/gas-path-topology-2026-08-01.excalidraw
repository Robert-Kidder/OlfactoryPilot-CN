    {"id":"a-note-text","type":"text","x":325,"y":1010,"width":420,"height":70,"angle":0,"strokeColor":"#2b8a3e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":153,"version":1,"versionNonce":1053,"isDeleted":false,"boundElements":null,"updated":1785542400000,"link":null,"locked":false,"index":"bG","text":"A · 样品侧总流量\n在气味通道 1–20 与补偿通道 21 之间路由；\n多通道可同时开启并共享 A 的总流量。","fontSize":18,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","baseline":64,"containerId":null,"originalText":"A · 样品侧总流量\n在气味通道 1–20 与补偿通道 21 之间路由；\n多通道可同时开启并共享 A 的总流量。","lineHeight":1.3},
