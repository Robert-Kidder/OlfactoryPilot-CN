# Python artifacts
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
.venv-win/

# Build outputs
build/
dist/
*.spec.cache/

# PyInstaller
*.manifest
*.log

# Tooling
.pytest_cache/
.ruff_cache/
.diagnostics/

# IDE/editor local settings
.vscode/

# Local AI/BMAD/Codex tooling and generated output.
# Long-lived project documents belong in docs/ and are committed.
.agents/
_bmad/
_bmad-output/

# Node/BMAD installer caches
node_modules/
