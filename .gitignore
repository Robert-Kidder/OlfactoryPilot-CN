!_bmad/
_bmad/*
!_bmad/custom/
_bmad/custom/*
!_bmad/custom/config.toml

# Local hardware/developer overrides
config/local_config.json

# Runtime state
logs/
last_shutdown_event.json
*.session.part/
recovery/

# Local tree export
structure.txt

# Experiment/runtime output files
*.raw
*.header
*.res
*.resPS
*.protocol
